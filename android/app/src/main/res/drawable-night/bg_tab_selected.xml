<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="5dp"
    android:insetTop="5dp"
    android:insetRight="5dp"
    android:insetBottom="5dp">
    <selector>
        <item android:state_pressed="true">
            <shape>
                <gradient android:angle="90" android:startColor="#B84F6383" android:centerColor="#A637475F" android:endColor="#8F293647" />
                <corners android:radius="23dp" />
                <stroke android:width="1dp" android:color="#80D5E3FF" />
            </shape>
        </item>
        <item>
            <shape>
                <gradient android:angle="90" android:startColor="#9A3E516D" android:centerColor="#8A2C384B" android:endColor="#7A303D52" />
                <corners android:radius="23dp" />
                <stroke android:width="1dp" android:color="#667FA4D9" />
            </shape>
        </item>
    </selector>
</inset>
