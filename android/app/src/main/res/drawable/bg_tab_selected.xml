<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="5dp"
    android:insetTop="5dp"
    android:insetRight="5dp"
    android:insetBottom="5dp">
    <selector>
        <item android:state_pressed="true">
            <shape>
                <gradient android:angle="90" android:startColor="#E6FFFFFF" android:centerColor="#CCFFFFFF" android:endColor="#A8D9E8F5" />
                <corners android:radius="23dp" />
                <stroke android:width="1dp" android:color="#CCFFFFFF" />
            </shape>
        </item>
        <item>
            <shape>
                <gradient android:angle="90" android:startColor="#CCFFFFFF" android:centerColor="#B3FFFFFF" android:endColor="#8FD7E9F7" />
                <corners android:radius="23dp" />
                <stroke android:width="1dp" android:color="#99FFFFFF" />
            </shape>
        </item>
    </selector>
</inset>
